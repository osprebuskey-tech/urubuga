# ---- Server ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Set to 1 when running behind one reverse proxy (Render, Nginx, Heroku...) so rate limiting sees real client IPs
TRUST_PROXY=0
# Interactive API docs at /api/docs. Default: on in development, off in production. Set true/false to override.
# API_DOCS_ENABLED=true

# ---- Database ----
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/imbehe
# Atlas (replace placeholders, URL-encode special characters in the password):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imbehe?retryWrites=true&w=majority

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
# Session length when someone ticks "Keep me signed in" (never applied to administrators, super admins or payment follow-up staff).
JWT_REMEMBER_EXPIRES_IN=14d
BCRYPT_ROUNDS=12

# ---- Web ----
CLIENT_URL=http://localhost:5173
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ---- Rate limits (per IP) ----
GLOBAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SENSITIVE_RATE_LIMIT_MAX=5
# search and directory listings, per minute
SEARCH_RATE_LIMIT_MAX=120
# creating service requests and quotations, per hour
WRITE_RATE_LIMIT_MAX=60
# days after a job is marked complete during which either side can report a problem
DISPUTE_WINDOW_DAYS=7

# --- Payments ---
# manual  = customers pay outside the app (mobile money / bank) and an administrator confirms it. Always available.
# sandbox = a FAKE gateway for development only. Refused when NODE_ENV=production.
PAYMENT_GATEWAY=manual
# Shared secret used to verify webhook signatures from the gateway. 16+ random characters. Never commit a real one.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MANUAL_INSTRUCTIONS=Send the amount by MTN MoMo or Airtel Money as instructed by Imbehe support, then wait for an administrator to confirm your payment.
# Platform commission in basis points (1200 = 12.00%). Administrators can change it later; it only affects new payments.
DEFAULT_COMMISSION_BPS=1200

# ---- Email ----
# console = log emails (development). A real provider is added in a later milestone.
# console = only logged (development). smtp = real delivery, needs SMTP_HOST, SMTP_USER and SMTP_PASS.
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # default: true for port 465, STARTTLS otherwise
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=Imbehe <no-reply@imbehe.test>

# ---- Seed script (development only) ----
# SEED_PASSWORD=ChangeMe123!

# ---- File uploads ----
# local = files saved to UPLOAD_DIR and served at /uploads (development / single server)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO...)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Public base URL of this API, used to build image URLs for the local driver
# Required in production when STORAGE_PROVIDER=local.
# PUBLIC_API_URL=http://localhost:5000
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=              # only for non-AWS providers (R2, MinIO)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=       # e.g. https://cdn.example.com (where uploaded keys are publicly readable)

# --- Identity documents (private storage) ---
# National ID, CV, RDB certificate. Stored OUTSIDE the public uploads folder and only streamed to the owner or reviewing staff.
MAX_DOCUMENT_MB=8
PRIVATE_UPLOAD_DIR=private-uploads
# Required in production when STORAGE_PROVIDER=s3: a bucket that is NOT publicly readable (server-side encrypted).
# S3_PRIVATE_BUCKET=imbehe-private-documents
